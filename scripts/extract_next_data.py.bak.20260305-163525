import os
import json
import re
from pathlib import Path

def extract_next_data(file_path):
    try:
        content = Path(file_path).read_text(encoding='utf-8', errors='ignore')
        # Standard Next.js __NEXT_DATA__
        matches = re.findall(r'<script id="__NEXT_DATA__" type="application/json">(.*?)</script>', content)
        # Also look for self.__next_f.push RSC payloads
        rsc_matches = re.findall(r'self\.__next_f\.push\(\[1,"(.*?)"\]\)', content)
        
        return {
            "next_data": [json.loads(m) for m in matches if m.strip()],
            "rsc_payloads": rsc_matches
        }
    except Exception as e:
        return {"error": str(e)}

def main():
    base_dir = Path("docs/restore")
    out_dir = Path("artifacts/extracted_next_data")
    out_dir.mkdir(parents=True, exist_ok=True)
    
    html_files = list(base_dir.glob("**/*.html"))
    print(f"Processing {len(html_files)} HTML files...")
    
    for html in html_files:
        data = extract_next_data(html)
        if data.get("next_data") or data.get("rsc_payloads"):
            safe_name = str(html).replace("/", "_").replace(".", "_") + ".json"
            (out_dir / safe_name).write_text(json.dumps(data, indent=2))

if __name__ == "__main__":
    main()
