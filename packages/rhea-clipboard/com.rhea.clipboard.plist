<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rhea.clipboard</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/sa/.pyenv/versions/3.11.9/bin/python3</string>
        <string>-m</string>
        <string>rhea_clipboard</string>
        <string>--no-tray</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/tmp/rhea-clipboard.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/rhea-clipboard.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>RHEA_SERVER</key>
        <string>https://rhea-tribunal.fly.dev</string>
    </dict>
</dict>
</plist>
