FROM python:3.11-slim

WORKDIR /app

# Install system deps + Tailscale for mesh networking
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl iptables \
    && curl -fsSL https://tailscale.com/install.sh | sh \
    && rm -rf /var/lib/apt/lists/*

# Install all dependencies including billing
RUN pip install --no-cache-dir \
    fastapi==0.128.8 \
    uvicorn==0.39.0 \
    requests==2.32.3 \
    litellm \
    toml==0.10.2 \
    pyjwt==2.10.1 \
    google-auth==2.38.0 \
    google-auth-httplib2==0.2.0 \
    stripe==11.4.1 \
    psycopg2-binary==2.9.10 \
    google-cloud-secret-manager==2.22.0

# Copy all source modules
COPY src/tribunal_api.py src/
COPY src/rhea_bridge.py src/
COPY src/consensus_analyzer.py src/
COPY src/aletheia_api.py src/
COPY src/aletheia_pipeline.py src/
COPY src/office.py src/
COPY src/token_governor.py src/
COPY src/task_db.py src/
COPY src/rhea_db.py src/
COPY src/rhea_profile_manager.py src/
COPY src/rhea_visual_context.py src/
COPY src/env_loader.py src/
COPY src/auth_api.py src/
COPY src/billing.py src/
COPY src/ndi_bridge.py src/
COPY src/task_queue.py src/
COPY src/rhea_supervisor.py src/
COPY src/workflow_engine.py src/
COPY src/crdb_store.py src/
COPY src/rhea_secrets.py src/

# Copy pre-built Atlas static frontend
COPY rhea-atlas-out/ static_frontend/

# Create runtime directories
RUN mkdir -p logs data

WORKDIR /app/src

EXPOSE 8400

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:8400/health')"

# Inline entrypoint (scripts/ is in .dockerignore)
RUN printf '#!/bin/bash\n\
if [ -n "$TAILSCALE_AUTHKEY" ]; then\n\
    tailscaled --state=/var/lib/tailscale/tailscaled.state --socket=/var/run/tailscale/tailscaled.sock &\n\
    sleep 2\n\
    tailscale up --authkey="$TAILSCALE_AUTHKEY" --hostname=rhea-tribunal\n\
    echo "[tailscale] joined tailnet as rhea-tribunal"\n\
fi\n\
exec uvicorn tribunal_api:app --host 0.0.0.0 --port 8400 --workers 2\n' > /app/entrypoint.sh \
    && chmod +x /app/entrypoint.sh

CMD ["/app/entrypoint.sh"]
