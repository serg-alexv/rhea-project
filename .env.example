# Rhea Platform — Environment Configuration
# Copy to .env and fill in your values:  cp .env.example .env

# === REQUIRED ===
JWT_SECRET=           # openssl rand -hex 32
GEMINI_API_KEY=       # Google AI Studio → https://aistudio.google.com/apikey

# === OPTIONAL: Additional model providers ===
ANTHROPIC_API_KEY=    # https://console.anthropic.com/
OPENAI_API_KEY=       # https://platform.openai.com/api-keys
OPENROUTER_API_KEY=   # https://openrouter.ai/keys
DEEPSEEK_API_KEY=     # https://platform.deepseek.com/api_keys

# === OPTIONAL: Admin API keys (comma-separated) ===
TRIBUNAL_API_KEYS=    # e.g. rhea-prod-abc123,rhea-prod-def456

# === OPTIONAL: Stripe billing (card payments) ===
STRIPE_SECRET_KEY=          # sk_live_... from https://dashboard.stripe.com/apikeys
STRIPE_WEBHOOK_SECRET=      # whsec_... from Stripe webhook endpoint config
STRIPE_PRO_PRICE_ID=        # price_... for Pro plan ($29/mo)
STRIPE_ENTERPRISE_PRICE_ID= # price_... for Enterprise plan ($99/mo)

# === OPTIONAL: BTCPay Server (BTC payments) ===
BTCPAY_WEBHOOK_SECRET=      # HMAC secret from BTCPay webhook settings

# === DEPLOYMENT ===
DOMAIN=localhost      # Your domain for Caddy auto-TLS (e.g. api.rhea.dev)
