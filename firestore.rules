// Rhea Office — Firestore Security Rules
// Allow reads and writes for authenticated users.
// Temporary rule valid until 2026-02-27. Replace with proper user-based rules after auth setup.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null && request.time < timestamp.date(2026, 2, 27);
    }
  }
}
