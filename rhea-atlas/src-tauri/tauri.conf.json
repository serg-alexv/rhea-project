{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rhea Command Centre",
  "version": "0.1.0",
  "identifier": "com.rhea.commandcentre",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000/cc",
    "beforeBuildCommand": "RHEA_STATIC_EXPORT=1 npm run build",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "windows": [
      {
        "title": "Rhea Command Centre",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "url": "/cc"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:* https://*.run.app https://*.europe-west1.run.app; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "wix": {}
    },
    "linux": {
      "deb": {},
      "rpm": {},
      "appimage": {}
    }
  },
  "plugins": {}
}
