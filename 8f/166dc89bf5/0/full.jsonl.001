{"parentUuid":"a1e47324-f6a7-4473-9f40-fe88bb3efaa4","isSidechain":false,"userType":"external","cwd":"/Users/sa/rh.1","sessionId":"94aabe90-9b2d-48e7-be8c-6bf820a0b6a9","version":"2.1.59","gitBranch":"stage4-release","slug":"snazzy-skipping-brook","type":"progress","data":{"type":"hook_progress","hookEvent":"PostToolUse","hookName":"PostToolUse:Read","command":"callback"},"parentToolUseID":"toolu_012Y35NDxufNeLxbTMMKmRU1","toolUseID":"toolu_012Y35NDxufNeLxbTMMKmRU1","timestamp":"2026-02-28T17:10:25.413Z","uuid":"8cdd6bbe-cfa3-4a9b-b5e0-bf0415f765ab"}
{"parentUuid":"a1e47324-f6a7-4473-9f40-fe88bb3efaa4","isSidechain":false,"userType":"external","cwd":"/Users/sa/rh.1","sessionId":"94aabe90-9b2d-48e7-be8c-6bf820a0b6a9","version":"2.1.59","gitBranch":"stage4-release","slug":"snazzy-skipping-brook","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012Y35NDxufNeLxbTMMKmRU1","type":"tool_result","content":"     1→import SwiftUI\n     2→\n     3→struct PulseQueueSummary: Codable {\n     4→    let total: Int\n     5→    let counts: [String: Int]\n     6→    let active_by_priority: [String: Int]\n     7→    let stale_count: Int\n     8→    let _updated: String?\n     9→}\n    10→\n    11→struct PulseAgentDTO: Codable {\n    12→    let name: String\n    13→    let alive: Bool\n    14→    let pace: String\n    15→    let mode: String\n    16→    let billing_mode: String\n    17→    let T_day: Int\n    18→    let dollar_day: Double\n    19→    let floor_gap: Int\n    20→    let lease_token: Int\n    21→    let lease_expired: Bool\n    22→    let lease_expires_at: String?\n    23→    let office_status: String\n    24→    let pending_msgs: Int\n    25→    let tasks_open: Int\n    26→    let tasks_claimed: Int\n    27→    let last_activity: String?\n    28→    let last_feed: String?\n    29→}\n    30→\n    31→struct PulseUnifiedResponse: Codable {\n    32→    let _ts: String\n    33→    let agents: [String: PulseAgentDTO]\n    34→}\n    35→\n    36→struct PulseMonitorView: View {\n    37→    @State private var summary: PulseQueueSummary? = nil\n    38→    @State private var agents: [String: PulseAgentDTO] = [:]\n    39→    @State private var loading = true\n    40→    @State private var lastAction = \"idle\"\n    41→    @State private var pollTimer: Timer? = nil\n    42→    @State private var flickerNote = \"screen flicker observed\"\n    43→    @AppStorage(\"apiBaseURL\") private var apiBaseURL = AppConfig.defaultAPIBaseURL\n    44→    @AppStorage(\"table_rex\") private var tableRex = true\n    45→    @AppStorage(\"table_orion\") private var tableOrion = true\n    46→    @AppStorage(\"table_gpt\") private var tableGpt = false\n    47→    @AppStorage(\"table_hyperion\") private var tableHyperion = true\n    48→    @AppStorage(\"table_gemini\") private var tableGemini = false\n    49→    @AppStorage(\"table_shared\") private var tableShared = false\n    50→    @AppStorage(\"family_visibility_only\") private var familyVisibilityOnly = false\n    51→\n    52→    var body: some View {\n    53→        NavigationStack {\n    54→            ScrollView {\n    55→                VStack(alignment: .leading, spacing: 14) {\n    56→                    pulseHeader\n    57→\n    58→                    tableControlCard\n    59→\n    60→                    flickerControlCard\n    61→\n    62→                    queueCard\n    63→\n    64→                    agentsCard\n    65→                }\n    66→                .padding(.horizontal)\n    67→                .padding(.bottom, 20)\n    68→            }\n    69→            .background(RheaTheme.bg)\n    70→            .navigationTitle(\"Pulse\")\n    71→            #if os(iOS)\n    72→            .toolbarColorScheme(.dark, for: .navigationBar)\n    73→            #endif\n    74→            .refreshable { await refresh() }\n    75→            .task {\n    76→                await refresh()\n    77→                startPolling()\n    78→            }\n    79→            .onDisappear {\n    80→                pollTimer?.invalidate()\n    81→                pollTimer = nil\n    82→            }\n    83→        }\n    84→    }\n    85→\n    86→    var pulseHeader: some View {\n    87→        let p0 = summary?.active_by_priority[\"P0\"] ?? 0\n    88→        let stale = summary?.stale_count ?? 0\n    89→        let openCount = summary?.counts[\"open\"] ?? 0\n    90→        let offline = agents.values.filter { !$0.alive }.count\n    91→        let risk = pulseRisk(p0: p0, stale: stale, offline: offline)\n    92→\n    93→        return VStack(alignment: .leading, spacing: 8) {\n    94→            HStack(spacing: 10) {\n    95→                MetricPill(label: \"Risk\", value: risk.label.uppercased(), color: risk.color)\n    96→                MetricPill(label: \"Open\", value: \"\\(openCount)\", color: .white)\n    97→                MetricPill(label: \"P0\", value: \"\\(p0)\", color: RheaTheme.red)\n    98→                MetricPill(label: \"Stale\", value: \"\\(stale)\", color: stale > 0 ? RheaTheme.amber : RheaTheme.green)\n    99→                MetricPill(label: \"Offline\", value: \"\\(offline)\", color: offline > 0 ? RheaTheme.amber : RheaTheme.green)\n   100→            }\n   101→            Text(\"last action: \\(lastAction)\")\n   102→                .font(.caption2)\n   103→                .foregroundStyle(.secondary)\n   104→        }\n   105→        .glassCard()\n   106→    }\n   107→\n   108→    var flickerControlCard: some View {\n   109→        VStack(alignment: .leading, spacing: 10) {\n   110→            Text(\"Flicker Control\")\n   111→                .font(.system(.headline, design: .rounded, weight: .bold))\n   112→                .foregroundStyle(.white)\n   113→\n   114→            TextField(\"flicker note\", text: $flickerNote)\n   115→                .textInputAutocapitalization(.never)\n   116→                .autocorrectionDisabled()\n   117→                .padding(.horizontal, 10)\n   118→                .padding(.vertical, 8)\n   119→                .background(\n   120→                    RoundedRectangle(cornerRadius: 10)\n   121→                        .fill(.white.opacity(0.07))\n   122→                )\n   123→\n   124→            HStack(spacing: 8) {\n   125→                Button(\"Mark Flicker\") {\n   126→                    Task { await markFlicker() }\n   127→                }\n   128→                .buttonStyle(.borderedProminent)\n   129→\n   130→                Button(\"Wake REX\") {\n   131→                    Task { await wake(\"REX\") }\n   132→                }\n   133→                .buttonStyle(.bordered)\n   134→\n   135→                Button(\"Create Trace Task\") {\n   136→                    Task { await createTraceTask() }\n   137→                }\n   138→                .buttonStyle(.bordered)\n   139→            }\n   140→            .font(.caption)\n   141→        }\n   142→        .glassCard()\n   143→    }\n   144→\n   145→    var tableControlCard: some View {\n   146→        VStack(alignment: .leading, spacing: 10) {\n   147→            Text(\"Family Table\")\n   148→                .font(.system(.headline, design: .rounded, weight: .bold))\n   149→                .foregroundStyle(.white)\n   150→            Text(\"Tap seats to include/exclude from current family scope.\")\n   151→                .font(.caption2)\n   152→                .foregroundStyle(.secondary)\n   153→\n   154→            HStack(spacing: 8) {\n   155→                SeatToggle(label: \"REX\", isOn: $tableRex, onColor: RheaTheme.accent)\n   156→                SeatToggle(label: \"ORION\", isOn: $tableOrion, onColor: .purple)\n   157→                SeatToggle(label: \"GPT\", isOn: $tableGpt, onColor: .indigo)\n   158→                SeatToggle(label: \"HYPERION\", isOn: $tableHyperion, onColor: .mint)\n   159→            }\n   160→            HStack(spacing: 8) {\n   161→                SeatToggle(label: \"GEMINI\", isOn: $tableGemini, onColor: RheaTheme.amber)\n   162→                SeatToggle(label: \"SHARED\", isOn: $tableShared, onColor: .gray)\n   163→                Spacer()\n   164→            }\n   165→\n   166→            Toggle(\"Apply family scope to visibility\", isOn: $familyVisibilityOnly)\n   167→                .font(.caption)\n   168→        }\n   169→        .glassCard()\n   170→    }\n   171→\n   172→    var queueCard: some View {\n   173→        VStack(alignment: .leading, spacing: 8) {\n   174→            Text(\"Queue\")\n   175→                .font(.system(.headline, design: .rounded, weight: .bold))\n   176→                .foregroundStyle(.white)\n   177→            if let s = summary {\n   178→                QueueRow(label: \"total\", value: \"\\(s.total)\")\n   179→                QueueRow(label: \"open\", value: \"\\(s.counts[\"open\"] ?? 0)\")\n   180→                QueueRow(label: \"claimed\", value: \"\\(s.counts[\"claimed\"] ?? 0)\")\n   181→                QueueRow(label: \"done\", value: \"\\(s.counts[\"done\"] ?? 0)\")\n   182→                QueueRow(label: \"blocked\", value: \"\\(s.counts[\"blocked\"] ?? 0)\")\n   183→                QueueRow(label: \"P0 active\", value: \"\\(s.active_by_priority[\"P0\"] ?? 0)\")\n   184→                QueueRow(label: \"stale\", value: \"\\(s.stale_count)\")\n   185→            } else if loading {\n   186→                ProgressView()\n   187→            } else {\n   188→                Text(\"No queue data\")\n   189→                    .foregroundStyle(.secondary)\n   190→            }\n   191→        }\n   192→        .glassCard()\n   193→    }\n   194→\n   195→    var agentsCard: some View {\n   196→        let seatSet = Set(activeSeatNames().map { $0.lowercased() })\n   197→        let keys = agents.keys.sorted().filter { key in\n   198→            if !familyVisibilityOnly { return true }\n   199→            return seatSet.contains(key.lowercased())\n   200→        }\n   201→        return VStack(alignment: .leading, spacing: 8) {\n   202→            Text(\"Agents\")\n   203→                .font(.system(.headline, design: .rounded, weight: .bold))\n   204→                .foregroundStyle(.white)\n   205→            if keys.isEmpty {\n   206→                Text(loading ? \"Loading...\" : \"No agent data\")\n   207→                    .foregroundStyle(.secondary)\n   208→            } else {\n   209→                ForEach(keys, id: \\.self) { key in\n   210→                    let a = agents[key]\n   211→                    HStack {\n   212→                        Circle()\n   213→                            .fill(RheaTheme.paceColor(a?.pace ?? \"red\"))\n   214→                            .frame(width: 8, height: 8)\n   215→                        VStack(alignment: .leading, spacing: 1) {\n   216→                            Text(key.uppercased())\n   217→                                .font(.system(.caption, design: .monospaced, weight: .semibold))\n   218→                                .foregroundStyle(.white)\n   219→                            HStack(spacing: 6) {\n   220→                                Text(a?.office_status ?? \"unknown\")\n   221→                                    .foregroundStyle((a?.alive ?? false) ? RheaTheme.green : RheaTheme.red)\n   222→                                if (a?.pending_msgs ?? 0) > 0 {\n   223→                                    Text(\"\\(a?.pending_msgs ?? 0)msg\")\n   224→                                        .foregroundStyle(RheaTheme.amber)\n   225→                                }\n   226→                            }\n   227→                            .font(.system(.caption2, design: .monospaced))\n   228→                        }\n   229→                        Spacer()\n   230→                        Text((a?.mode ?? \"?\").uppercased())\n   231→                            .font(.system(.caption2, design: .rounded, weight: .semibold))\n   232→                            .foregroundStyle(RheaTheme.modeColor(a?.mode ?? \"normal\"))\n   233→                        Button {\n   234→                            Task { await wake(key.uppercased()) }\n   235→                        } label: {\n   236→                            Text(\"Wake\")\n   237→                                .font(.system(.caption2, design: .monospaced, weight: .bold))\n   238→                                .foregroundStyle(RheaTheme.amber)\n   239→                                .padding(.horizontal, 8)\n   240→                                .padding(.vertical, 3)\n   241→                                .background(Capsule().strokeBorder(RheaTheme.amber.opacity(0.4), lineWidth: 1))\n   242→                        }\n   243→                        .buttonStyle(.plain)\n   244→                    }\n   245→                }\n   246→            }\n   247→        }\n   248→        .glassCard()\n   249→    }\n   250→\n   251→    func activeSeatNames() -> [String] {\n   252→        var out: [String] = []\n   253→        if tableRex { out.append(\"rex\") }\n   254→        if tableOrion { out.append(\"orion\") }\n   255→        if tableGpt { out.append(\"gpt\") }\n   256→        if tableHyperion { out.append(\"hyperion\") }\n   257→        if tableGemini { out.append(\"gemini\") }\n   258→        if tableShared { out.append(\"shared\") }\n   259→        return out\n   260→    }\n   261→\n   262→    func pulseRisk(p0: Int, stale: Int, offline: Int) -> (label: String, color: Color) {\n   263→        if p0 > 0 || stale > 0 { return (\"critical\", RheaTheme.red) }\n   264→        if offline > 0 { return (\"warn\", RheaTheme.amber) }\n   265→        return (\"ok\", RheaTheme.green)\n   266→    }\n   267→\n   268→    func startPolling() {\n   269→        pollTimer?.invalidate()\n   270→        pollTimer = Timer.scheduledTimer(withTimeInterval: 5.0, repeats: true) { _ in\n   271→            Task { await refresh() }\n   272→        }\n   273→    }\n   274→\n   275→    func refresh() async {\n   276→        loading = true\n   277→        defer { loading = false }\n   278→        await fetchSummary()\n   279→        await fetchAgents()\n   280→    }\n   281→\n   282→    func fetchSummary() async {\n   283→        guard let url = URL(string: \"\\(apiBaseURL)/tasks/summary\") else { return }\n   284→        do {\n   285→            let (data, _) = try await URLSession.shared.data(from: url)\n   286→            summary = try JSONDecoder().decode(PulseQueueSummary.self, from: data)\n   287→        } catch {\n   288→            summary = nil\n   289→        }\n   290→    }\n   291→\n   292→    func fetchAgents() async {\n   293→        guard let url = URL(string: \"\\(apiBaseURL)/agents/status\") else { return }\n   294→        do {\n   295→            let (data, _) = try await URLSession.shared.data(from: url)\n   296→            let resp = try JSONDecoder().decode(PulseUnifiedResponse.self, from: data)\n   297→            agents = resp.agents\n   298→        } catch {\n   299→            agents = [:]\n   300→        }\n   301→    }\n   302→\n   303→    func markFlicker() async {\n   304→        guard let url = URL(string: \"\\(apiBaseURL)/feed/push\") else { return }\n   305→        var req = URLRequest(url: url)\n   306→        req.httpMethod = \"POST\"\n   307→        req.setValue(\"application/json\", forHTTPHeaderField: \"Content-Type\")\n   308→        let note = flickerNote.trimmingCharacters(in: .whitespacesAndNewlines)\n   309→        let payload: [String: Any] = [\n   310→            \"sender\": \"human\",\n   311→            \"receiver\": \"all\",\n   312→            \"type\": \"radio\",\n   313→            \"text\": \"[flicker] \\(note.isEmpty ? \"screen flicker observed\" : note)\"\n   314→        ]\n   315→        req.httpBody = try? JSONSerialization.data(withJSONObject: payload)\n   316→        do {\n   317→            let (_, response) = try await URLSession.shared.data(for: req)\n   318→            if let http = response as? HTTPURLResponse, http.statusCode < 300 {\n   319→                lastAction = \"flicker marked\"\n   320→            } else {\n   321→                lastAction = \"flicker mark failed\"\n   322→            }\n   323→        } catch {\n   324→            lastAction = \"flicker mark error\"\n   325→        }\n   326→    }\n   327→\n   328→    func wake(_ agent: String) async {\n   329→        guard let url = URL(string: \"\\(apiBaseURL)/agents/wake/\\(agent)\") else { return }\n   330→        var req = URLRequest(url: url)\n   331→        req.httpMethod = \"POST\"\n   332→        do {\n   333→            let (_, response) = try await URLSession.shared.data(for: req)\n   334→            if let http = response as? HTTPURLResponse, http.statusCode < 300 {\n   335→                lastAction = \"wake \\(agent) sent\"\n   336→            } else {\n   337→                lastAction = \"wake \\(agent) failed\"\n   338→            }\n   339→        } catch {\n   340→            lastAction = \"wake \\(agent) error\"\n   341→        }\n   342→    }\n   343→\n   344→    func createTraceTask() async {\n   345→        var comps = URLComponents(string: \"\\(apiBaseURL)/tasks\")\n   346→        comps?.queryItems = [\n   347→            URLQueryItem(name: \"title\", value: \"Investigate screen flicker + correlate with NDI pulse\"),\n   348→            URLQueryItem(name: \"priority\", value: \"P0\"),\n   349→            URLQueryItem(name: \"agent\", value: \"orion\"),\n   350→            URLQueryItem(name: \"tags\", value: \"flicker,ndi,diagnostics,pulse\"),\n   351→        ]\n   352→        guard let url = comps?.url else { return }\n   353→        var req = URLRequest(url: url)\n   354→        req.httpMethod = \"POST\"\n   355→        do {\n   356→            let (_, response) = try await URLSession.shared.data(for: req)\n   357→            if let http = response as? HTTPURLResponse, http.statusCode < 300 {\n   358→                lastAction = \"trace task created\"\n   359→                await fetchSummary()\n   360→            } else {\n   361→                lastAction = \"trace task create failed\"\n   362→            }\n   363→        } catch {\n   364→            lastAction = \"trace task create error\"\n   365→        }\n   366→    }\n   367→}\n   368→\n   369→private struct QueueRow: View {\n   370→    let label: String\n   371→    let value: String\n   372→\n   373→    var body: some View {\n   374→        HStack {\n   375→            Text(label)\n   376→                .font(.system(.caption, design: .monospaced))\n   377→                .foregroundStyle(.secondary)\n   378→            Spacer()\n   379→            Text(value)\n   380→                .font(.system(.caption, design: .monospaced, weight: .semibold))\n   381→                .foregroundStyle(.white)\n   382→        }\n   383→    }\n   384→}\n   385→\n   386→private struct SeatToggle: View {\n   387→    let label: String\n   388→    @Binding var isOn: Bool\n   389→    let onColor: Color\n   390→\n   391→    var body: some View {\n   392→        Button {\n   393→            isOn.toggle()\n   394→        } label: {\n   395→            Text(label)\n   396→                .font(.system(.caption2, design: .monospaced, weight: .bold))\n   397→                .foregroundStyle(isOn ? .black : .secondary)\n   398→                .padding(.horizontal, 10)\n   399→                .padding(.vertical, 6)\n   400→                .background(\n   401→                    Capsule().fill(isOn ? onColor : .white.opacity(0.08))\n   402→                )\n   403→        }\n   404→        .buttonStyle(.plain)\n   405→    }\n   406→}\n   407→"}]},"uuid":"2c77a615-8204-4f24-ae1c-ff75ff554995","timestamp":"2026-02-28T17:10:25.412Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/sa/rh.1/ios/RheaPreview.swiftpm/Sources/PulseMonitorView.swift","content":"import SwiftUI\n\nstruct PulseQueueSummary: Codable {\n    let total: Int\n    let counts: [String: Int]\n    let active_by_priority: [String: Int]\n    let stale_count: Int\n    let _updated: String?\n}\n\nstruct PulseAgentDTO: Codable {\n    let name: String\n    let alive: Bool\n    let pace: String\n    let mode: String\n    let billing_mode: String\n    let T_day: Int\n    let dollar_day: Double\n    let floor_gap: Int\n    let lease_token: Int\n    let lease_expired: Bool\n    let lease_expires_at: String?\n    let office_status: String\n    let pending_msgs: Int\n    let tasks_open: Int\n    let tasks_claimed: Int\n    let last_activity: String?\n    let last_feed: String?\n}\n\nstruct PulseUnifiedResponse: Codable {\n    let _ts: String\n    let agents: [String: PulseAgentDTO]\n}\n\nstruct PulseMonitorView: View {\n    @State private var summary: PulseQueueSummary? = nil\n    @State private var agents: [String: PulseAgentDTO] = [:]\n    @State private var loading = true\n    @State private var lastAction = \"idle\"\n    @State private var pollTimer: Timer? = nil\n    @State private var flickerNote = \"screen flicker observed\"\n    @AppStorage(\"apiBaseURL\") private var apiBaseURL = AppConfig.defaultAPIBaseURL\n    @AppStorage(\"table_rex\") private var tableRex = true\n    @AppStorage(\"table_orion\") private var tableOrion = true\n    @AppStorage(\"table_gpt\") private var tableGpt = false\n    @AppStorage(\"table_hyperion\") private var tableHyperion = true\n    @AppStorage(\"table_gemini\") private var tableGemini = false\n    @AppStorage(\"table_shared\") private var tableShared = false\n    @AppStorage(\"family_visibility_only\") private var familyVisibilityOnly = false\n\n    var body: some View {\n        NavigationStack {\n            ScrollView {\n                VStack(alignment: .leading, spacing: 14) {\n                    pulseHeader\n\n                    tableControlCard\n\n                    flickerControlCard\n\n                    queueCard\n\n                    agentsCard\n                }\n                .padding(.horizontal)\n                .padding(.bottom, 20)\n            }\n            .background(RheaTheme.bg)\n            .navigationTitle(\"Pulse\")\n            #if os(iOS)\n            .toolbarColorScheme(.dark, for: .navigationBar)\n            #endif\n            .refreshable { await refresh() }\n            .task {\n                await refresh()\n                startPolling()\n            }\n            .onDisappear {\n                pollTimer?.invalidate()\n                pollTimer = nil\n            }\n        }\n    }\n\n    var pulseHeader: some View {\n        let p0 = summary?.active_by_priority[\"P0\"] ?? 0\n        let stale = summary?.stale_count ?? 0\n        let openCount = summary?.counts[\"open\"] ?? 0\n        let offline = agents.values.filter { !$0.alive }.count\n        let risk = pulseRisk(p0: p0, stale: stale, offline: offline)\n\n        return VStack(alignment: .leading, spacing: 8) {\n            HStack(spacing: 10) {\n                MetricPill(label: \"Risk\", value: risk.label.uppercased(), color: risk.color)\n                MetricPill(label: \"Open\", value: \"\\(openCount)\", color: .white)\n                MetricPill(label: \"P0\", value: \"\\(p0)\", color: RheaTheme.red)\n                MetricPill(label: \"Stale\", value: \"\\(stale)\", color: stale > 0 ? RheaTheme.amber : RheaTheme.green)\n                MetricPill(label: \"Offline\", value: \"\\(offline)\", color: offline > 0 ? RheaTheme.amber : RheaTheme.green)\n            }\n            Text(\"last action: \\(lastAction)\")\n                .font(.caption2)\n                .foregroundStyle(.secondary)\n        }\n        .glassCard()\n    }\n\n    var flickerControlCard: some View {\n        VStack(alignment: .leading, spacing: 10) {\n            Text(\"Flicker Control\")\n                .font(.system(.headline, design: .rounded, weight: .bold))\n                .foregroundStyle(.white)\n\n            TextField(\"flicker note\", text: $flickerNote)\n                .textInputAutocapitalization(.never)\n                .autocorrectionDisabled()\n                .padding(.horizontal, 10)\n                .padding(.vertical, 8)\n                .background(\n                    RoundedRectangle(cornerRadius: 10)\n                        .fill(.white.opacity(0.07))\n                )\n\n            HStack(spacing: 8) {\n                Button(\"Mark Flicker\") {\n                    Task { await markFlicker() }\n                }\n                .buttonStyle(.borderedProminent)\n\n                Button(\"Wake REX\") {\n                    Task { await wake(\"REX\") }\n                }\n                .buttonStyle(.bordered)\n\n                Button(\"Create Trace Task\") {\n                    Task { await createTraceTask() }\n                }\n                .buttonStyle(.bordered)\n            }\n            .font(.caption)\n        }\n        .glassCard()\n    }\n\n    var tableControlCard: some View {\n        VStack(alignment: .leading, spacing: 10) {\n            Text(\"Family Table\")\n                .font(.system(.headline, design: .rounded, weight: .bold))\n                .foregroundStyle(.white)\n            Text(\"Tap seats to include/exclude from current family scope.\")\n                .font(.caption2)\n                .foregroundStyle(.secondary)\n\n            HStack(spacing: 8) {\n                SeatToggle(label: \"REX\", isOn: $tableRex, onColor: RheaTheme.accent)\n                SeatToggle(label: \"ORION\", isOn: $tableOrion, onColor: .purple)\n                SeatToggle(label: \"GPT\", isOn: $tableGpt, onColor: .indigo)\n                SeatToggle(label: \"HYPERION\", isOn: $tableHyperion, onColor: .mint)\n            }\n            HStack(spacing: 8) {\n                SeatToggle(label: \"GEMINI\", isOn: $tableGemini, onColor: RheaTheme.amber)\n                SeatToggle(label: \"SHARED\", isOn: $tableShared, onColor: .gray)\n                Spacer()\n            }\n\n            Toggle(\"Apply family scope to visibility\", isOn: $familyVisibilityOnly)\n                .font(.caption)\n        }\n        .glassCard()\n    }\n\n    var queueCard: some View {\n        VStack(alignment: .leading, spacing: 8) {\n            Text(\"Queue\")\n                .font(.system(.headline, design: .rounded, weight: .bold))\n                .foregroundStyle(.white)\n            if let s = summary {\n                QueueRow(label: \"total\", value: \"\\(s.total)\")\n                QueueRow(label: \"open\", value: \"\\(s.counts[\"open\"] ?? 0)\")\n                QueueRow(label: \"claimed\", value: \"\\(s.counts[\"claimed\"] ?? 0)\")\n                QueueRow(label: \"done\", value: \"\\(s.counts[\"done\"] ?? 0)\")\n                QueueRow(label: \"blocked\", value: \"\\(s.counts[\"blocked\"] ?? 0)\")\n                QueueRow(label: \"P0 active\", value: \"\\(s.active_by_priority[\"P0\"] ?? 0)\")\n                QueueRow(label: \"stale\", value: \"\\(s.stale_count)\")\n            } else if loading {\n                ProgressView()\n            } else {\n                Text(\"No queue data\")\n                    .foregroundStyle(.secondary)\n            }\n        }\n        .glassCard()\n    }\n\n    var agentsCard: some View {\n        let seatSet = Set(activeSeatNames().map { $0.lowercased() })\n        let keys = agents.keys.sorted().filter { key in\n            if !familyVisibilityOnly { return true }\n            return seatSet.contains(key.lowercased())\n        }\n        return VStack(alignment: .leading, spacing: 8) {\n            Text(\"Agents\")\n                .font(.system(.headline, design: .rounded, weight: .bold))\n                .foregroundStyle(.white)\n            if keys.isEmpty {\n                Text(loading ? \"Loading...\" : \"No agent data\")\n                    .foregroundStyle(.secondary)\n            } else {\n                ForEach(keys, id: \\.self) { key in\n                    let a = agents[key]\n                    HStack {\n                        Circle()\n                            .fill(RheaTheme.paceColor(a?.pace ?? \"red\"))\n                            .frame(width: 8, height: 8)\n                        VStack(alignment: .leading, spacing: 1) {\n                            Text(key.uppercased())\n                                .font(.system(.caption, design: .monospaced, weight: .semibold))\n                                .foregroundStyle(.white)\n                            HStack(spacing: 6) {\n                                Text(a?.office_status ?? \"unknown\")\n                                    .foregroundStyle((a?.alive ?? false) ? RheaTheme.green : RheaTheme.red)\n                                if (a?.pending_msgs ?? 0) > 0 {\n                                    Text(\"\\(a?.pending_msgs ?? 0)msg\")\n                                        .foregroundStyle(RheaTheme.amber)\n                                }\n                            }\n                            .font(.system(.caption2, design: .monospaced))\n                        }\n                        Spacer()\n                        Text((a?.mode ?? \"?\").uppercased())\n                            .font(.system(.caption2, design: .rounded, weight: .semibold))\n                            .foregroundStyle(RheaTheme.modeColor(a?.mode ?? \"normal\"))\n                        Button {\n                            Task { await wake(key.uppercased()) }\n                        } label: {\n                            Text(\"Wake\")\n                                .font(.system(.caption2, design: .monospaced, weight: .bold))\n                                .foregroundStyle(RheaTheme.amber)\n                                .padding(.horizontal, 8)\n                                .padding(.vertical, 3)\n                                .background(Capsule().strokeBorder(RheaTheme.amber.opacity(0.4), lineWidth: 1))\n                        }\n                        .buttonStyle(.plain)\n                    }\n                }\n            }\n        }\n        .glassCard()\n    }\n\n    func activeSeatNames() -> [String] {\n        var out: [String] = []\n        if tableRex { out.append(\"rex\") }\n        if tableOrion { out.append(\"orion\") }\n        if tableGpt { out.append(\"gpt\") }\n        if tableHyperion { out.append(\"hyperion\") }\n        if tableGemini { out.append(\"gemini\") }\n        if tableShared { out.append(\"shared\") }\n        return out\n    }\n\n    func pulseRisk(p0: Int, stale: Int, offline: Int) -> (label: String, color: Color) {\n        if p0 > 0 || stale > 0 { return (\"critical\", RheaTheme.red) }\n        if offline > 0 { return (\"warn\", RheaTheme.amber) }\n        return (\"ok\", RheaTheme.green)\n    }\n\n    func startPolling() {\n        pollTimer?.invalidate()\n        pollTimer = Timer.scheduledTimer(withTimeInterval: 5.0, repeats: true) { _ in\n            Task { await refresh() }\n        }\n    }\n\n    func refresh() async {\n        loading = true\n        defer { loading = false }\n        await fetchSummary()\n        await fetchAgents()\n    }\n\n    func fetchSummary() async {\n        guard let url = URL(string: \"\\(apiBaseURL)/tasks/summary\") else { return }\n        do {\n            let (data, _) = try await URLSession.shared.data(from: url)\n            summary = try JSONDecoder().decode(PulseQueueSummary.self, from: data)\n        } catch {\n            summary = nil\n        }\n    }\n\n    func fetchAgents() async {\n        guard let url = URL(string: \"\\(apiBaseURL)/agents/status\") else { return }\n        do {\n            let (data, _) = try await URLSession.shared.data(from: url)\n            let resp = try JSONDecoder().decode(PulseUnifiedResponse.self, from: data)\n            agents = resp.agents\n        } catch {\n            agents = [:]\n        }\n    }\n\n    func markFlicker() async {\n        guard let url = URL(string: \"\\(apiBaseURL)/feed/push\") else { return }\n        var req = URLRequest(url: url)\n        req.httpMethod = \"POST\"\n        req.setValue(\"application/json\", forHTTPHeaderField: \"Content-Type\")\n        let note = flickerNote.trimmingCharacters(in: .whitespacesAndNewlines)\n        let payload: [String: Any] = [\n            \"sender\": \"human\",\n            \"receiver\": \"all\",\n            \"type\": \"radio\",\n            \"text\": \"[flicker] \\(note.isEmpty ? \"screen flicker observed\" : note)\"\n        ]\n        req.httpBody = try? JSONSerialization.data(withJSONObject: payload)\n        do {\n            let (_, response) = try await URLSession.shared.data(for: req)\n            if let http = response as? HTTPURLResponse, http.statusCode < 300 {\n                lastAction = \"flicker marked\"\n            } else {\n                lastAction = \"flicker mark failed\"\n            }\n        } catch {\n            lastAction = \"flicker mark error\"\n        }\n    }\n\n    func wake(_ agent: String) async {\n        guard let url = URL(string: \"\\(apiBaseURL)/agents/wake/\\(agent)\") else { return }\n        var req = URLRequest(url: url)\n        req.httpMethod = \"POST\"\n        do {\n            let (_, response) = try await URLSession.shared.data(for: req)\n            if let http = response as? HTTPURLResponse, http.statusCode < 300 {\n                lastAction = \"wake \\(agent) sent\"\n            } else {\n                lastAction = \"wake \\(agent) failed\"\n            }\n        } catch {\n            lastAction = \"wake \\(agent) error\"\n        }\n    }\n\n    func createTraceTask() async {\n        var comps = URLComponents(string: \"\\(apiBaseURL)/tasks\")\n        comps?.queryItems = [\n            URLQueryItem(name: \"title\", value: \"Investigate screen flicker + correlate with NDI pulse\"),\n            URLQueryItem(name: \"priority\", value: \"P0\"),\n            URLQueryItem(name: \"agent\", value: \"orion\"),\n            URLQueryItem(name: \"tags\", value: \"flicker,ndi,diagnostics,pulse\"),\n        ]\n        guard let url = comps?.url else { return }\n        var req = URLRequest(url: url)\n        req.httpMethod = \"POST\"\n        do {\n            let (_, response) = try await URLSession.shared.data(for: req)\n            if let http = response as? HTTPURLResponse, http.statusCode < 300 {\n                lastAction = \"trace task created\"\n                await fetchSummary()\n            } else {\n                lastAction = \"trace task create failed\"\n            }\n        } catch {\n            lastAction = \"trace task create error\"\n        }\n    }\n}\n\nprivate struct QueueRow: View {\n    let label: String\n    let value: String\n\n    var body: some View {\n        HStack {\n            Text(label)\n                .font(.system(.caption, design: .monospaced))\n                .foregroundStyle(.secondary)\n            Spacer()\n            Text(value)\n                .font(.system(.caption, design: .monospaced, weight: .semibold))\n                .foregroundStyle(.white)\n        }\n    }\n}\n\nprivate struct SeatToggle: View {\n    let label: String\n    @Binding var isOn: Bool\n    let onColor: Color\n\n    var body: some View {\n        Button {\n            isOn.toggle()\n        } label: {\n            Text(label)\n                .font(.system(.caption2, design: .monospaced, weight: .bold))\n                .foregroundStyle(isOn ? .black : .secondary)\n                .padding(.horizontal, 10)\n                .padding(.vertical, 6)\n                .background(\n                    Capsule().fill(isOn ? onColor : .white.opacity(0.08))\n                )\n        }\n        .buttonStyle(.plain)\n    }\n}\n","numLines":407,"startLine":1,"totalLines":407}},"sourceToolAssistantUUID":"a1e47324-f6a7-4473-9f40-fe88bb3efaa4"}
