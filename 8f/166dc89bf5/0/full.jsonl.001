{"parentUuid":"ad57d710-2729-4d02-9332-008c92b6cc20","isSidechain":false,"userType":"external","cwd":"/Users/sa/rh.1","sessionId":"94aabe90-9b2d-48e7-be8c-6bf820a0b6a9","version":"2.1.59","gitBranch":"stage4-release","slug":"snazzy-skipping-brook","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CVn1euRNtr53a598fZoa3U","type":"tool_result","content":"     1→#!/usr/bin/env python3\n     2→\"\"\"\n     3→tribunal_api.py — FastAPI wrapper for Rhea Tribunal consensus API.\n     4→\n     5→Endpoints:\n     6→    POST /tribunal          — Level 1 (local) or Level 2 (chairman) consensus\n     7→    POST /tribunal/ice      — Level 3 (ICE iterative) consensus\n     8→    GET  /health            — Health check\n     9→    GET  /models            — Available models and providers\n    10→\n    11→Usage:\n    12→    uvicorn tribunal_api:app --host 0.0.0.0 --port 8400\n    13→    # or: python3 src/tribunal_api.py\n    14→\"\"\"\n    15→from __future__ import annotations\n    16→\n    17→import os\n    18→import sys\n    19→import time\n    20→import json\n    21→import hashlib\n    22→import base64\n    23→import binascii\n    24→import secrets\n    25→import uuid\n    26→import subprocess\n    27→from datetime import datetime, timezone, timedelta\n    28→from pathlib import Path\n    29→from typing import Optional\n    30→\n    31→from fastapi import FastAPI, HTTPException, Header, Depends\n    32→from fastapi.middleware.cors import CORSMiddleware\n    33→from fastapi.responses import StreamingResponse\n    34→from pydantic import BaseModel, Field\n    35→\n    36→_PROJECT_ROOT = Path(__file__).resolve().parent.parent\n    37→\n    38→# ---------------------------------------------------------------------------\n    39→# Global event bus — SSE radio frequency for all agents\n    40→# ---------------------------------------------------------------------------\n    41→import asyncio\n    42→import collections\n    43→\n    44→_EVENT_BUS: asyncio.Queue = None  # lazy-init per event loop\n    45→_SUBSCRIBERS: list = []  # list of asyncio.Queue (one per SSE client)\n    46→_RADIO_LOG: list = []  # in-memory log of pushed/broadcast messages (included in /feed)\n    47→\n    48→def _broadcast_event(event: dict):\n    49→    \"\"\"Push event to all connected SSE subscribers AND in-memory radio log.\"\"\"\n    50→    _RADIO_LOG.append(event)"}]},"uuid":"068c4163-da66-47be-9a99-8b7d55d4cb71","timestamp":"2026-02-28T17:09:58.280Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/sa/rh.1/src/tribunal_api.py","content":"#!/usr/bin/env python3\n\"\"\"\ntribunal_api.py — FastAPI wrapper for Rhea Tribunal consensus API.\n\nEndpoints:\n    POST /tribunal          — Level 1 (local) or Level 2 (chairman) consensus\n    POST /tribunal/ice      — Level 3 (ICE iterative) consensus\n    GET  /health            — Health check\n    GET  /models            — Available models and providers\n\nUsage:\n    uvicorn tribunal_api:app --host 0.0.0.0 --port 8400\n    # or: python3 src/tribunal_api.py\n\"\"\"\nfrom __future__ import annotations\n\nimport os\nimport sys\nimport time\nimport json\nimport hashlib\nimport base64\nimport binascii\nimport secrets\nimport uuid\nimport subprocess\nfrom datetime import datetime, timezone, timedelta\nfrom pathlib import Path\nfrom typing import Optional\n\nfrom fastapi import FastAPI, HTTPException, Header, Depends\nfrom fastapi.middleware.cors import CORSMiddleware\nfrom fastapi.responses import StreamingResponse\nfrom pydantic import BaseModel, Field\n\n_PROJECT_ROOT = Path(__file__).resolve().parent.parent\n\n# ---------------------------------------------------------------------------\n# Global event bus — SSE radio frequency for all agents\n# ---------------------------------------------------------------------------\nimport asyncio\nimport collections\n\n_EVENT_BUS: asyncio.Queue = None  # lazy-init per event loop\n_SUBSCRIBERS: list = []  # list of asyncio.Queue (one per SSE client)\n_RADIO_LOG: list = []  # in-memory log of pushed/broadcast messages (included in /feed)\n\ndef _broadcast_event(event: dict):\n    \"\"\"Push event to all connected SSE subscribers AND in-memory radio log.\"\"\"\n    _RADIO_LOG.append(event)","numLines":50,"startLine":1,"totalLines":2362}},"sourceToolAssistantUUID":"ad57d710-2729-4d02-9332-008c92b6cc20"}
