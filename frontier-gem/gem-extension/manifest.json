{
  "manifest_version": 3,
  "name": "Gem Observer",
  "version": "1.0",
  "description": "Rhea frontier gem - native messaging bridge for system monitoring",
  
  "permissions": [
    "activeTab",
    "tabs",
    "nativeMessaging",
    "webRequest"
  ],
  
  "host_permissions": [
    "<all_urls>"
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "icons": {
    "16": "/images/icon-16.png",
    "48": "/images/icon-48.png",
    "128": "/images/icon-128.png"
  }
}
    