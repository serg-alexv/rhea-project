{"parentUuid":"1ce4343f-5be0-4177-993c-f823603e5245","isSidechain":false,"userType":"external","cwd":"/Users/sa/rh.1","sessionId":"94aabe90-9b2d-48e7-be8c-6bf820a0b6a9","version":"2.1.59","gitBranch":"stage4-release","slug":"snazzy-skipping-brook","type":"progress","data":{"type":"hook_progress","hookEvent":"PostToolUse","hookName":"PostToolUse:Read","command":"callback"},"parentToolUseID":"toolu_01YWmDPRDXtAvWhFa3gchDPy","toolUseID":"toolu_01YWmDPRDXtAvWhFa3gchDPy","timestamp":"2026-02-28T15:17:55.551Z","uuid":"d734702f-af5a-4fb2-8eea-524733235d6d"}
{"parentUuid":"1ce4343f-5be0-4177-993c-f823603e5245","isSidechain":false,"userType":"external","cwd":"/Users/sa/rh.1","sessionId":"94aabe90-9b2d-48e7-be8c-6bf820a0b6a9","version":"2.1.59","gitBranch":"stage4-release","slug":"snazzy-skipping-brook","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YWmDPRDXtAvWhFa3gchDPy","type":"tool_result","content":"     1→import SwiftUI\n     2→import Charts\n     3→import Pow\n     4→\n     5→struct AgentStatus: Codable, Identifiable {\n     6→    var id: String { name }\n     7→    let name: String\n     8→    let alive: Bool\n     9→    let pace: String\n    10→    let forecast: String?\n    11→    let mode: String\n    12→    let billing_mode: String?\n    13→    let upper_rail_enabled: Bool?\n    14→    let T_day: Int\n    15→    let dollar_day: Double\n    16→    let budget_cap: Double?\n    17→    let budget_remaining: Double?\n    18→    let floor_expected: Int?\n    19→    let floor_gap: Int\n    20→    let hour: Int?\n    21→    let hard_fail: Bool\n    22→    // Office enrichment\n    23→    let office_status: String?\n    24→    let pending_msgs: Int?\n    25→    let tasks_open: Int?\n    26→    let tasks_claimed: Int?\n    27→    let last_activity: String?\n    28→\n    29→    // Compat: old code uses .agent\n    30→    var agent: String { name }\n    31→}\n    32→\n    33→struct GovernorView: View {\n    34→    @State private var agents: [AgentStatus] = []\n    35→    @State private var loading = true\n    36→    @State private var refreshCount = 0\n    37→    @AppStorage(\"apiBaseURL\") private var apiBaseURL = AppConfig.defaultAPIBaseURL\n    38→\n    39→    var body: some View {\n    40→        NavigationStack {\n    41→            ScrollView {\n    42→                if loading {\n    43→                    ProgressView()\n    44→                        .frame(maxWidth: .infinity, minHeight: 300)\n    45→                } else if agents.isEmpty {\n    46→                    ContentUnavailableView(\"No Data\", systemImage: \"gauge.with.dots.needle.0percent\",\n    47→                                           description: Text(\"Governor API not reachable\"))\n    48→                } else {\n    49→                    LazyVStack(spacing: 14) {\n    50→                        // Summary header\n    51→                        summaryHeader\n    52→\n    53→                        ForEach(agents) { agent in\n    54→                            AgentCard(status: agent)\n    55→                                .transition(.movingParts.pop(.white))\n    56→                        }\n    57→                    }\n    58→                    .padding(.horizontal)\n    59→                    .padding(.bottom, 20)\n    60→                }\n    61→            }\n    62→            .background(RheaTheme.bg)\n    63→            .navigationTitle(\"Governor\")\n    64→            #if os(iOS)\n    65→            .toolbarColorScheme(.dark, for: .navigationBar)\n    66→            #endif\n    67→            .refreshable { await fetch() }\n    68→            .task { await fetch() }\n    69→        }\n    70→    }\n    71→\n    72→    var summaryHeader: some View {\n    73→        let totalTokens = agents.reduce(0) { $0 + $1.T_day }\n    74→        let totalCost = agents.reduce(0.0) { $0 + $1.dollar_day }\n    75→        let stableCount = agents.filter { $0.mode == \"normal\" && !$0.hard_fail }.count\n    76→        let onTrackCount = agents.filter { $0.floor_gap <= 0 }.count\n    77→\n    78→        return VStack(alignment: .leading, spacing: 8) {\n    79→            HStack(spacing: 12) {\n    80→                MetricPill(label: \"Agents\", value: \"\\(agents.count)\", color: RheaTheme.accent)\n    81→                MetricPill(label: \"Stable\", value: \"\\(stableCount)/\\(agents.count)\",\n    82→                           color: stableCount == agents.count ? RheaTheme.green : RheaTheme.amber)\n    83→                MetricPill(label: \"Tokens\", value: formatTokens(totalTokens), color: .white)\n    84→                MetricPill(label: \"Cost\", value: \"$\\(String(format: \"%.2f\", totalCost))\", color: RheaTheme.amber)\n    85→            }\n    86→\n    87→            Text(\"On track: \\(onTrackCount)/\\(agents.count) (floor trajectory)\")\n    88→                .font(.caption2)\n    89→                .foregroundStyle(.secondary)\n    90→        }\n    91→        .glassCard()\n    92→    }\n    93→\n    94→    struct GovernorUnifiedResponse: Codable {\n    95→        let _ts: String\n    96→        let agents: [String: AgentStatus]\n    97→    }\n    98→\n    99→    func fetch() async {\n   100→        loading = true\n   101→        defer { loading = false }\n   102→        guard let url = URL(string: \"\\(apiBaseURL)/agents/status\") else { return }\n   103→        do {\n   104→            let (data, _) = try await URLSession.shared.data(from: url)\n   105→            let resp = try JSONDecoder().decode(GovernorUnifiedResponse.self, from: data)\n   106→            withAnimation(.spring(duration: 0.4)) {\n   107→                agents = resp.agents.values.sorted { $0.agent < $1.agent }\n   108→                refreshCount += 1\n   109→            }\n   110→        } catch {\n   111→            agents = []\n   112→        }\n   113→    }\n   114→\n   115→    func formatTokens(_ n: Int) -> String {\n   116→        if n >= 1_000_000 { return \"\\(n / 1_000_000)M\" }\n   117→        if n >= 1_000 { return \"\\(n / 1_000)K\" }\n   118→        return \"\\(n)\"\n   119→    }\n   120→}\n   121→\n   122→// MARK: - MetricPill\n   123→struct MetricPill: View {\n   124→    let label: String\n   125→    let value: String\n   126→    let color: Color\n   127→\n   128→    var body: some View {\n   129→        VStack(spacing: 4) {\n   130→            Text(value)\n   131→                .font(.system(.title3, design: .rounded, weight: .bold))\n   132→                .foregroundStyle(color)\n   133→            Text(label)\n   134→                .font(.caption2)\n   135→                .foregroundStyle(.secondary)\n   136→        }\n   137→        .frame(maxWidth: .infinity)\n   138→    }\n   139→}\n   140→\n   141→// MARK: - AgentCard\n   142→struct AgentCard: View {\n   143→    let status: AgentStatus\n   144→    @State private var appeared = false\n   145→    @State private var actionInProgress: String? = nil\n   146→    @AppStorage(\"apiBaseURL\") private var apiBaseURL = AppConfig.defaultAPIBaseURL\n   147→\n   148→    var budgetFraction: Double {\n   149→        guard let cap = status.budget_cap, cap > 0 else { return 0 }\n   150→        return min(status.dollar_day / cap, 1.0)\n   151→    }\n   152→\n   153→    var body: some View {\n   154→        VStack(alignment: .leading, spacing: 12) {\n   155→            // Header row: name + mode badge\n   156→            HStack {\n   157→                HStack(spacing: 8) {\n   158→                    Circle()\n   159→                        .fill(RheaTheme.paceColor(status.pace))\n   160→                        .frame(width: 10, height: 10)\n   161→                        .changeEffect(.pulse(shape: Circle(), count: 2), value: status.pace, isEnabled: status.pace == \"red\")\n   162→\n   163→                    Text(status.agent.uppercased())\n   164→                        .font(.system(.headline, design: .monospaced, weight: .bold))\n   165→                        .foregroundStyle(.white)\n   166→                }\n   167→\n   168→                Spacer()\n   169→\n   170→                Text(status.mode.uppercased())\n   171→                    .font(.system(.caption2, design: .rounded, weight: .semibold))\n   172→                    .padding(.horizontal, 10)\n   173→                    .padding(.vertical, 4)\n   174→                    .background(\n   175→                        Capsule().fill(RheaTheme.modeColor(status.mode).opacity(0.25))\n   176→                    )\n   177→                    .foregroundStyle(RheaTheme.modeColor(status.mode))\n   178→                    .changeEffect(.shake(rate: .fast), value: status.mode, isEnabled: status.mode == \"hard_fail\")\n   179→            }\n   180→\n   181→            // Budget gauge (only for API-billed agents with budget_cap > 0)\n   182→            if (status.budget_cap ?? 0) > 0 {\n   183→                VStack(alignment: .leading, spacing: 6) {\n   184→                    HStack {\n   185→                        Text(\"Budget\")\n   186→                            .font(.caption)\n   187→                            .foregroundStyle(.secondary)\n   188→                        Spacer()\n   189→                        Text(\"$\\(String(format: \"%.2f\", status.dollar_day)) / $\\(String(format: \"%.0f\", status.budget_cap ?? 0))\")\n   190→                            .font(.system(.caption, design: .monospaced))\n   191→                            .foregroundStyle(.white.opacity(0.7))\n   192→                    }\n   193→\n   194→                    GeometryReader { geo in\n   195→                        ZStack(alignment: .leading) {\n   196→                            RoundedRectangle(cornerRadius: 4)\n   197→                                .fill(.white.opacity(0.08))\n   198→                            RoundedRectangle(cornerRadius: 4)\n   199→                                .fill(budgetFraction < 0.6 ? RheaTheme.green :\n   200→                                      budgetFraction < 0.85 ? RheaTheme.amber :\n   201→                                      RheaTheme.red)\n   202→                                .frame(width: geo.size.width * budgetFraction)\n   203→                                .animation(.spring(duration: 0.6), value: budgetFraction)\n   204→                        }\n   205→                    }\n   206→                    .frame(height: 6)\n   207→                }\n   208→            }\n   209→\n   210→            if status.billing_mode == \"subscription\" {\n   211→                Text(\"subscription mode\")\n   212→                    .font(.caption2)\n   213→                    .foregroundStyle(.secondary)\n   214→            }\n   215→\n   216→            // Office status enrichment\n   217→            if let officeStatus = status.office_status {\n   218→                HStack(spacing: 8) {\n   219→                    Text(officeStatus)\n   220→                        .font(.system(.caption2, design: .monospaced, weight: .semibold))\n   221→                        .foregroundStyle(status.alive ? RheaTheme.green : RheaTheme.red)\n   222→                    if let pending = status.pending_msgs, pending > 0 {\n   223→                        Text(\"\\(pending) pending\")\n   224→                            .font(.system(.caption2, design: .monospaced))\n   225→                            .foregroundStyle(RheaTheme.amber)\n   226→                    }\n   227→                    if let open = status.tasks_open, open > 0 {\n   228→                        Text(\"\\(open) tasks\")\n   229→                            .font(.system(.caption2, design: .monospaced))\n   230→                            .foregroundStyle(.secondary)\n   231→                    }\n   232→                }\n   233→            }\n   234→\n   235→            // Stats row\n   236→            HStack(spacing: 16) {\n   237→                StatChip(icon: \"number\", text: formatTokens(status.T_day))\n   238→                StatChip(icon: \"clock\", text: \"h\\(status.hour ?? 0)\")\n   239→                if status.floor_gap > 0 {\n   240→                    StatChip(icon: \"arrow.down.to.line\", text: \"gap:\\(status.floor_gap)\", color: RheaTheme.amber)\n   241→                }\n   242→                Spacer()\n   243→                Text(status.floor_gap > 0 ? \"behind floor\" : \"on track\")\n   244→                    .font(.system(.caption2, design: .monospaced))\n   245→                    .foregroundStyle(status.floor_gap > 0 ? RheaTheme.amber : RheaTheme.green)\n   246→            }\n   247→\n   248→            // Action buttons\n   249→            HStack(spacing: 10) {\n   250→                AgentActionButton(label: \"Wake\", icon: \"bolt.fill\", color: RheaTheme.amber, isLoading: actionInProgress == \"wake\") {\n   251→                    await performAction(\"wake\")\n   252→                }\n   253→                AgentActionButton(label: \"Ping\", icon: \"antenna.radiowaves.left.and.right\", color: RheaTheme.accent, isLoading: actionInProgress == \"ping\") {\n   254→                    await performAction(\"ping\")\n   255→                }\n   256→                Spacer()\n   257→            }\n   258→        }\n   259→        .glassCard()\n   260→        .opacity(appeared ? 1 : 0)\n   261→        .offset(y: appeared ? 0 : 20)\n   262→        .onAppear {\n   263→            withAnimation(.spring(duration: 0.5, bounce: 0.3)) {\n   264→                appeared = true\n   265→            }\n   266→        }\n   267→    }\n   268→\n   269→    func performAction(_ action: String) async {\n   270→        actionInProgress = action\n   271→        defer { actionInProgress = nil }\n   272→        let endpoint = action == \"wake\" ? \"agents/wake/\\(status.agent)\" : \"feed/push\"\n   273→        guard let url = URL(string: \"\\(apiBaseURL)/\\(endpoint)\") else { return }\n   274→        var request = URLRequest(url: url)\n   275→        request.httpMethod = \"POST\"\n   276→        if action == \"ping\" {\n   277→            request.setValue(\"application/json\", forHTTPHeaderField: \"Content-Type\")\n   278→            let body: [String: Any] = [\"sender\": \"human\", \"text\": \"PING \\(status.agent)\", \"type\": \"radio\"]\n   279→            request.httpBody = try? JSONSerialization.data(withJSONObject: body)\n   280→        }\n   281→        do {\n   282→            let (_, response) = try await URLSession.shared.data(for: request)\n   283→            if let http = response as? HTTPURLResponse, http.statusCode < 300 {\n   284→                #if os(iOS)\n   285→                UINotificationFeedbackGenerator().notificationOccurred(.success)\n   286→                #endif\n   287→            }\n   288→        } catch {}\n   289→    }\n   290→\n   291→    func formatTokens(_ n: Int) -> String {\n   292→        if n >= 1_000_000 { return \"\\(n / 1_000_000)M\" }\n   293→        if n >= 1_000 { return \"\\(n / 1_000)K\" }\n   294→        return \"\\(n)\"\n   295→    }\n   296→}\n   297→\n   298→// MARK: - AgentActionButton\n   299→struct AgentActionButton: View {\n   300→    let label: String\n   301→    let icon: String\n   302→    let color: Color\n   303→    let isLoading: Bool\n   304→    let action: () async -> Void\n   305→\n   306→    var body: some View {\n   307→        Button {\n   308→            Task { await action() }\n   309→        } label: {\n   310→            HStack(spacing: 4) {\n   311→                if isLoading {\n   312→                    ProgressView()\n   313→                        .tint(color)\n   314→                        .controlSize(.mini)\n   315→                } else {\n   316→                    Image(systemName: icon)\n   317→                        .font(.system(size: 10, weight: .bold))\n   318→                }\n   319→                Text(label)\n   320→                    .font(.system(.caption2, design: .monospaced, weight: .bold))\n   321→            }\n   322→            .foregroundStyle(color)\n   323→            .padding(.horizontal, 10)\n   324→            .padding(.vertical, 5)\n   325→            .background(\n   326→                Capsule().strokeBorder(color.opacity(0.4), lineWidth: 1)\n   327→                    .background(Capsule().fill(color.opacity(0.1)))\n   328→            )\n   329→        }\n   330→        .buttonStyle(.plain)\n   331→        .disabled(isLoading)\n   332→    }\n   333→}\n   334→\n   335→// MARK: - StatChip\n   336→struct StatChip: View {\n   337→    let icon: String\n   338→    let text: String\n   339→    var color: Color = .secondary\n   340→\n   341→    var body: some View {\n   342→        HStack(spacing: 4) {\n   343→            Image(systemName: icon)\n   344→                .font(.system(size: 10))\n   345→            Text(text)\n   346→                .font(.system(.caption2, design: .monospaced))\n   347→        }\n   348→        .foregroundStyle(color)\n   349→    }\n   350→}\n   351→"}]},"uuid":"2149ec9c-95df-4613-bbf9-2d9ab86e6f35","timestamp":"2026-02-28T15:17:55.550Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/sa/rh.1/ios/RheaPreview.swiftpm/Sources/GovernorView.swift","content":"import SwiftUI\nimport Charts\nimport Pow\n\nstruct AgentStatus: Codable, Identifiable {\n    var id: String { name }\n    let name: String\n    let alive: Bool\n    let pace: String\n    let forecast: String?\n    let mode: String\n    let billing_mode: String?\n    let upper_rail_enabled: Bool?\n    let T_day: Int\n    let dollar_day: Double\n    let budget_cap: Double?\n    let budget_remaining: Double?\n    let floor_expected: Int?\n    let floor_gap: Int\n    let hour: Int?\n    let hard_fail: Bool\n    // Office enrichment\n    let office_status: String?\n    let pending_msgs: Int?\n    let tasks_open: Int?\n    let tasks_claimed: Int?\n    let last_activity: String?\n\n    // Compat: old code uses .agent\n    var agent: String { name }\n}\n\nstruct GovernorView: View {\n    @State private var agents: [AgentStatus] = []\n    @State private var loading = true\n    @State private var refreshCount = 0\n    @AppStorage(\"apiBaseURL\") private var apiBaseURL = AppConfig.defaultAPIBaseURL\n\n    var body: some View {\n        NavigationStack {\n            ScrollView {\n                if loading {\n                    ProgressView()\n                        .frame(maxWidth: .infinity, minHeight: 300)\n                } else if agents.isEmpty {\n                    ContentUnavailableView(\"No Data\", systemImage: \"gauge.with.dots.needle.0percent\",\n                                           description: Text(\"Governor API not reachable\"))\n                } else {\n                    LazyVStack(spacing: 14) {\n                        // Summary header\n                        summaryHeader\n\n                        ForEach(agents) { agent in\n                            AgentCard(status: agent)\n                                .transition(.movingParts.pop(.white))\n                        }\n                    }\n                    .padding(.horizontal)\n                    .padding(.bottom, 20)\n                }\n            }\n            .background(RheaTheme.bg)\n            .navigationTitle(\"Governor\")\n            #if os(iOS)\n            .toolbarColorScheme(.dark, for: .navigationBar)\n            #endif\n            .refreshable { await fetch() }\n            .task { await fetch() }\n        }\n    }\n\n    var summaryHeader: some View {\n        let totalTokens = agents.reduce(0) { $0 + $1.T_day }\n        let totalCost = agents.reduce(0.0) { $0 + $1.dollar_day }\n        let stableCount = agents.filter { $0.mode == \"normal\" && !$0.hard_fail }.count\n        let onTrackCount = agents.filter { $0.floor_gap <= 0 }.count\n\n        return VStack(alignment: .leading, spacing: 8) {\n            HStack(spacing: 12) {\n                MetricPill(label: \"Agents\", value: \"\\(agents.count)\", color: RheaTheme.accent)\n                MetricPill(label: \"Stable\", value: \"\\(stableCount)/\\(agents.count)\",\n                           color: stableCount == agents.count ? RheaTheme.green : RheaTheme.amber)\n                MetricPill(label: \"Tokens\", value: formatTokens(totalTokens), color: .white)\n                MetricPill(label: \"Cost\", value: \"$\\(String(format: \"%.2f\", totalCost))\", color: RheaTheme.amber)\n            }\n\n            Text(\"On track: \\(onTrackCount)/\\(agents.count) (floor trajectory)\")\n                .font(.caption2)\n                .foregroundStyle(.secondary)\n        }\n        .glassCard()\n    }\n\n    struct GovernorUnifiedResponse: Codable {\n        let _ts: String\n        let agents: [String: AgentStatus]\n    }\n\n    func fetch() async {\n        loading = true\n        defer { loading = false }\n        guard let url = URL(string: \"\\(apiBaseURL)/agents/status\") else { return }\n        do {\n            let (data, _) = try await URLSession.shared.data(from: url)\n            let resp = try JSONDecoder().decode(GovernorUnifiedResponse.self, from: data)\n            withAnimation(.spring(duration: 0.4)) {\n                agents = resp.agents.values.sorted { $0.agent < $1.agent }\n                refreshCount += 1\n            }\n        } catch {\n            agents = []\n        }\n    }\n\n    func formatTokens(_ n: Int) -> String {\n        if n >= 1_000_000 { return \"\\(n / 1_000_000)M\" }\n        if n >= 1_000 { return \"\\(n / 1_000)K\" }\n        return \"\\(n)\"\n    }\n}\n\n// MARK: - MetricPill\nstruct MetricPill: View {\n    let label: String\n    let value: String\n    let color: Color\n\n    var body: some View {\n        VStack(spacing: 4) {\n            Text(value)\n                .font(.system(.title3, design: .rounded, weight: .bold))\n                .foregroundStyle(color)\n            Text(label)\n                .font(.caption2)\n                .foregroundStyle(.secondary)\n        }\n        .frame(maxWidth: .infinity)\n    }\n}\n\n// MARK: - AgentCard\nstruct AgentCard: View {\n    let status: AgentStatus\n    @State private var appeared = false\n    @State private var actionInProgress: String? = nil\n    @AppStorage(\"apiBaseURL\") private var apiBaseURL = AppConfig.defaultAPIBaseURL\n\n    var budgetFraction: Double {\n        guard let cap = status.budget_cap, cap > 0 else { return 0 }\n        return min(status.dollar_day / cap, 1.0)\n    }\n\n    var body: some View {\n        VStack(alignment: .leading, spacing: 12) {\n            // Header row: name + mode badge\n            HStack {\n                HStack(spacing: 8) {\n                    Circle()\n                        .fill(RheaTheme.paceColor(status.pace))\n                        .frame(width: 10, height: 10)\n                        .changeEffect(.pulse(shape: Circle(), count: 2), value: status.pace, isEnabled: status.pace == \"red\")\n\n                    Text(status.agent.uppercased())\n                        .font(.system(.headline, design: .monospaced, weight: .bold))\n                        .foregroundStyle(.white)\n                }\n\n                Spacer()\n\n                Text(status.mode.uppercased())\n                    .font(.system(.caption2, design: .rounded, weight: .semibold))\n                    .padding(.horizontal, 10)\n                    .padding(.vertical, 4)\n                    .background(\n                        Capsule().fill(RheaTheme.modeColor(status.mode).opacity(0.25))\n                    )\n                    .foregroundStyle(RheaTheme.modeColor(status.mode))\n                    .changeEffect(.shake(rate: .fast), value: status.mode, isEnabled: status.mode == \"hard_fail\")\n            }\n\n            // Budget gauge (only for API-billed agents with budget_cap > 0)\n            if (status.budget_cap ?? 0) > 0 {\n                VStack(alignment: .leading, spacing: 6) {\n                    HStack {\n                        Text(\"Budget\")\n                            .font(.caption)\n                            .foregroundStyle(.secondary)\n                        Spacer()\n                        Text(\"$\\(String(format: \"%.2f\", status.dollar_day)) / $\\(String(format: \"%.0f\", status.budget_cap ?? 0))\")\n                            .font(.system(.caption, design: .monospaced))\n                            .foregroundStyle(.white.opacity(0.7))\n                    }\n\n                    GeometryReader { geo in\n                        ZStack(alignment: .leading) {\n                            RoundedRectangle(cornerRadius: 4)\n                                .fill(.white.opacity(0.08))\n                            RoundedRectangle(cornerRadius: 4)\n                                .fill(budgetFraction < 0.6 ? RheaTheme.green :\n                                      budgetFraction < 0.85 ? RheaTheme.amber :\n                                      RheaTheme.red)\n                                .frame(width: geo.size.width * budgetFraction)\n                                .animation(.spring(duration: 0.6), value: budgetFraction)\n                        }\n                    }\n                    .frame(height: 6)\n                }\n            }\n\n            if status.billing_mode == \"subscription\" {\n                Text(\"subscription mode\")\n                    .font(.caption2)\n                    .foregroundStyle(.secondary)\n            }\n\n            // Office status enrichment\n            if let officeStatus = status.office_status {\n                HStack(spacing: 8) {\n                    Text(officeStatus)\n                        .font(.system(.caption2, design: .monospaced, weight: .semibold))\n                        .foregroundStyle(status.alive ? RheaTheme.green : RheaTheme.red)\n                    if let pending = status.pending_msgs, pending > 0 {\n                        Text(\"\\(pending) pending\")\n                            .font(.system(.caption2, design: .monospaced))\n                            .foregroundStyle(RheaTheme.amber)\n                    }\n                    if let open = status.tasks_open, open > 0 {\n                        Text(\"\\(open) tasks\")\n                            .font(.system(.caption2, design: .monospaced))\n                            .foregroundStyle(.secondary)\n                    }\n                }\n            }\n\n            // Stats row\n            HStack(spacing: 16) {\n                StatChip(icon: \"number\", text: formatTokens(status.T_day))\n                StatChip(icon: \"clock\", text: \"h\\(status.hour ?? 0)\")\n                if status.floor_gap > 0 {\n                    StatChip(icon: \"arrow.down.to.line\", text: \"gap:\\(status.floor_gap)\", color: RheaTheme.amber)\n                }\n                Spacer()\n                Text(status.floor_gap > 0 ? \"behind floor\" : \"on track\")\n                    .font(.system(.caption2, design: .monospaced))\n                    .foregroundStyle(status.floor_gap > 0 ? RheaTheme.amber : RheaTheme.green)\n            }\n\n            // Action buttons\n            HStack(spacing: 10) {\n                AgentActionButton(label: \"Wake\", icon: \"bolt.fill\", color: RheaTheme.amber, isLoading: actionInProgress == \"wake\") {\n                    await performAction(\"wake\")\n                }\n                AgentActionButton(label: \"Ping\", icon: \"antenna.radiowaves.left.and.right\", color: RheaTheme.accent, isLoading: actionInProgress == \"ping\") {\n                    await performAction(\"ping\")\n                }\n                Spacer()\n            }\n        }\n        .glassCard()\n        .opacity(appeared ? 1 : 0)\n        .offset(y: appeared ? 0 : 20)\n        .onAppear {\n            withAnimation(.spring(duration: 0.5, bounce: 0.3)) {\n                appeared = true\n            }\n        }\n    }\n\n    func performAction(_ action: String) async {\n        actionInProgress = action\n        defer { actionInProgress = nil }\n        let endpoint = action == \"wake\" ? \"agents/wake/\\(status.agent)\" : \"feed/push\"\n        guard let url = URL(string: \"\\(apiBaseURL)/\\(endpoint)\") else { return }\n        var request = URLRequest(url: url)\n        request.httpMethod = \"POST\"\n        if action == \"ping\" {\n            request.setValue(\"application/json\", forHTTPHeaderField: \"Content-Type\")\n            let body: [String: Any] = [\"sender\": \"human\", \"text\": \"PING \\(status.agent)\", \"type\": \"radio\"]\n            request.httpBody = try? JSONSerialization.data(withJSONObject: body)\n        }\n        do {\n            let (_, response) = try await URLSession.shared.data(for: request)\n            if let http = response as? HTTPURLResponse, http.statusCode < 300 {\n                #if os(iOS)\n                UINotificationFeedbackGenerator().notificationOccurred(.success)\n                #endif\n            }\n        } catch {}\n    }\n\n    func formatTokens(_ n: Int) -> String {\n        if n >= 1_000_000 { return \"\\(n / 1_000_000)M\" }\n        if n >= 1_000 { return \"\\(n / 1_000)K\" }\n        return \"\\(n)\"\n    }\n}\n\n// MARK: - AgentActionButton\nstruct AgentActionButton: View {\n    let label: String\n    let icon: String\n    let color: Color\n    let isLoading: Bool\n    let action: () async -> Void\n\n    var body: some View {\n        Button {\n            Task { await action() }\n        } label: {\n            HStack(spacing: 4) {\n                if isLoading {\n                    ProgressView()\n                        .tint(color)\n                        .controlSize(.mini)\n                } else {\n                    Image(systemName: icon)\n                        .font(.system(size: 10, weight: .bold))\n                }\n                Text(label)\n                    .font(.system(.caption2, design: .monospaced, weight: .bold))\n            }\n            .foregroundStyle(color)\n            .padding(.horizontal, 10)\n            .padding(.vertical, 5)\n            .background(\n                Capsule().strokeBorder(color.opacity(0.4), lineWidth: 1)\n                    .background(Capsule().fill(color.opacity(0.1)))\n            )\n        }\n        .buttonStyle(.plain)\n        .disabled(isLoading)\n    }\n}\n\n// MARK: - StatChip\nstruct StatChip: View {\n    let icon: String\n    let text: String\n    var color: Color = .secondary\n\n    var body: some View {\n        HStack(spacing: 4) {\n            Image(systemName: icon)\n                .font(.system(size: 10))\n            Text(text)\n                .font(.system(.caption2, design: .monospaced))\n        }\n        .foregroundStyle(color)\n    }\n}\n","numLines":351,"startLine":1,"totalLines":351}},"sourceToolAssistantUUID":"1ce4343f-5be0-4177-993c-f823603e5245"}
